# Copy to .env (root, used by Prisma), apps/api/.env and apps/web/.env.local
# PowerShell: Copy-Item .env.example .env ; Copy-Item .env.example apps/api/.env ; Copy-Item .env.example apps/web/.env.local

# ── Database (local development) ──
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/baytul_wisaal?schema=public"

# ── apps/api ──
API_PORT=4000
# Browser origins allowed to call the API (comma-separated)
WEB_ORIGIN="http://localhost:3000"
# Used for links inside emails
APP_WEB_URL="http://localhost:3000"

# Session cookie. Defaults are right for localhost.
# For production set COOKIE_SECURE=true and, if web and API are on sibling subdomains,
# COOKIE_DOMAIN=.yourdomain.com
# COOKIE_NAME=bw_session
# COOKIE_SECURE=false
# COOKIE_SAMESITE=lax

# Email. Leave RESEND_API_KEY empty in development: emails (with their links) print in the API terminal.
# RESEND_API_KEY=
# EMAIL_FROM="Baytul Wisaal <noreply@yourdomain.com>"

# Set to 1 when the API runs behind a reverse proxy
# TRUST_PROXY=1

# ── apps/web ──
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"
# SESSION_COOKIE_NAME=bw_session
