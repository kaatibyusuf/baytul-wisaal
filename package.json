{
  "name": "baytul-wisaal",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "pnpm --filter @bw/web dev",
    "dev:api": "pnpm --filter @bw/api dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "pnpm --filter @bw/api test",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema prisma/schema.prisma",
    "db:validate": "prisma validate --schema prisma/schema.prisma",
    "db:seed": "pnpm --filter @bw/api seed"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3"
  },
  "devDependencies": {
    "prisma": "^6.19.3",
    "tsx": "^4.23.15",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
