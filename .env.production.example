# Production and staging variables. Never commit real values. Set these in Railway (API) and Vercel (web).

# ───────── API (Railway) ─────────
# Railway fills DATABASE_URL for you when you reference the Postgres service: ${{Postgres.DATABASE_URL}}
DATABASE_URL=
NODE_ENV=production
TRUST_PROXY=2

# Browser origins allowed to call the API. Staging: your Vercel address. Later: your real domain too.
WEB_ORIGIN=https://YOUR-APP.vercel.app
APP_WEB_URL=https://YOUR-APP.vercel.app

# Staging without a domain (Vercel forwards /api/v1 to the API): leave COOKIE_DOMAIN empty.
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
# With a real domain and api.yourdomain.com + app.yourdomain.com, set: COOKIE_DOMAIN=.yourdomain.com

# Email (Resend). Needs a verified sending domain for real use.
RESEND_API_KEY=
EMAIL_FROM="Baytul Wisaal <noreply@yourdomain.com>"
EMAIL_NOTIFICATIONS=auto

# AI scenario assessment. Use the model names currently listed by each provider.
AI_MODE=consensus
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# ───────── Web (Vercel) ─────────
# Staging without a domain: the browser calls the site itself and Next forwards to the API.
NEXT_PUBLIC_API_URL=/api/v1
API_INTERNAL_URL=https://YOUR-API.up.railway.app
# With a real domain, instead: NEXT_PUBLIC_API_URL=https://api.yourdomain.com/api/v1 and leave API_INTERNAL_URL unset.
